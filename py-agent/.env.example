# Ravita Agent – Python Environment Configuration
# Copy this file to .env and fill in your values.

# ─── AI Vendor ────────────────────────────────────────────────────────────────
# Choose the AI provider: "claude" | "gemini" | "openai"
AI_VENDOR=claude

# ─── AI Model ─────────────────────────────────────────────────────────────────
# The model name to use for the selected vendor.
# claude  → claude-opus-4-5  (recommended) | claude-haiku-4-5 (faster/cheaper)
# gemini  → gemini-2.0-flash (recommended) | gemini-1.5-pro
# openai  → gpt-4o           (recommended) | gpt-4o-mini      (faster/cheaper)
AI_MODEL=claude-opus-4-5

# ─── API Key ──────────────────────────────────────────────────────────────────
# Your API key for the selected vendor.
# claude  → https://console.anthropic.com/account/keys
# gemini  → https://aistudio.google.com/app/apikey
# openai  → https://platform.openai.com/api-keys
API_KEY=your-api-key-here

# ─── Workspace ────────────────────────────────────────────────────────────────
# Absolute or relative path to the codebase the agent should work on.
# Relative paths are resolved from the directory where main.py runs.
WORKSPACE_PATH=./workspace

# ─── Agent Behaviour ──────────────────────────────────────────────────────────
# Set to "true" to print verbose tool-call and API request logs to stderr.
AGENT_VERBOSE=false

# ─── BMad Mode ────────────────────────────────────────────────────────────────
# Set to "true" to enable the BMad multi-agent system.
# When false, only the Ravita developer agent runs (single-agent mode).
BMAD_MODE=false
